# Copy to .env and fill in. .env is git-ignored; never commit real values.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/multiplayer_ai
PORT=4100
HOST=127.0.0.1

# Names the deployment. Anything other than development/dev/local/test turns on a startup check
# that refuses to boot with any development setting still enabled.
#
# It fails closed: a hosted origin (Render sets RENDER=true) or a bind that is not loopback is
# treated as production even when this is unset, because the deployment that never set it was
# exactly the one running unprotected. A laptop serving a LAN says DEPLOYMENT_ENV=development,
# which is a decision somebody makes rather than a variable they forgot.
DEPLOYMENT_ENV=development

# A session cookie is marked Secure unless this is 0. Over plain HTTP nothing will store it, so
# a workspace served without TLS has to say so here or nobody can hold a session against it.
AUTH_COOKIE_SECURE=1

# Hands an authenticated caller another person's single-use sign-in token, which is their account.
# For a local deployment with no email transport and nothing else; a production environment refuses
# to boot with it on. Leave it unset.
MPAI_OPERATOR_SIGN_IN_LINKS=<unset>

# How sign-in links reach people.
#   logging  development only — the raw link is written to the server log for the operator
#   resend   real email through Resend; requires the three variables below
#   silent   delivers nothing; for automated tests
SIGN_IN_DELIVERY=logging

# Required when SIGN_IN_DELIVERY=resend. Missing any of them is a startup failure, never a
# silent downgrade to logging.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Multiplayer AI <sign-in@auth.webpulseaudit.com>
AUTH_EMAIL_REPLY_TO=rocco@webpulseaudit.com

# Where a sign-in link points. An https origin carries the token in the URL fragment, so it never
# reaches a web host or a link scanner; a custom scheme such as multiplayerai://auth carries it
# in the query and goes straight to the app.
PUBLIC_APP_URL=
