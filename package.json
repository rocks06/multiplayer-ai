{
  "name": "multiplayer-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --config vite.config.ts",
    "dev:marketing": "vite --config vite.marketing.config.ts",
    "dev:worker": "tsx watch apps/worker/src/server.ts",
    "start": "node dist/apps/api/src/server.js",
    "start:worker": "node dist/apps/worker/src/server.js",
    "typecheck": "tsc --noEmit",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config vite.config.ts",
    "build:marketing": "vite build --config vite.marketing.config.ts",
    "build": "pnpm build:server && pnpm build:web && pnpm build:marketing",
    "test": "vitest run",
    "test:frontend": "vitest run --config vitest.ui.config.ts tests/room-ui.test.tsx",
    "test:marketing": "vitest run --config vitest.ui.config.ts tests/marketing-site.test.tsx",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:watch": "vitest",
    "db:migrate": "tsx packages/db/src/migrate.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.6.2",
    "lucide-react": "^1.34.0",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^13.0.0",
    "ws": "^8.21.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.0.15"
  }
}
