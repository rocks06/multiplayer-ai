{
  "name": "multiplayer-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "dev:worker": "tsx watch apps/worker/src/server.ts",
    "start": "node dist/apps/api/src/server.js",
    "start:worker": "node dist/apps/worker/src/server.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx packages/db/src/migrate.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "uuid": "^13.0.0",
    "ws": "^8.21.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
